# Copy to .env (git-ignored) next to local_service.py, then restart the service.
ANTHROPIC_API_KEY=
# Optional: override the decision-engine model (default claude-opus-5-5).
# APPLYPILOT_MODEL=claude-sonnet-5-5
# Optional: only accept requests from this extension ID (see chrome://extensions).
# APPLYPILOT_EXTENSION_ID=
# Optional: change the port (also update the service URL on the Profile page).
# APPLYPILOT_PORT=8765
