{
  "manifest_version": 3,
  "name": "ApplyPilot — Job Application Assistant",
  "version": "0.5.0",
  "description": "Review-first assistant for mapping an approved profile to visible job-application fields.",
  "action": {
    "default_title": "ApplyPilot — Job Application Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "store-assets/icon16.png",
      "32": "store-assets/icon32.png",
      "48": "store-assets/icon48.png",
      "128": "store-assets/icon128.png"
    }
  },
  "icons": {
    "16": "store-assets/icon16.png",
    "32": "store-assets/icon32.png",
    "48": "store-assets/icon48.png",
    "128": "store-assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ]
}
