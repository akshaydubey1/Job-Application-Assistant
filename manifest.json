{
  "manifest_version": 3,
  "name": "ApplyPilot — Job Application Assistant",
  "version": "0.6.0",
  "description": "Review-first job application agent: fills approved fields, drafts answers, scores fit, tailors materials, and tracks applications.",
  "action": {
    "default_title": "ApplyPilot — Job Application Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "store-assets/icon16.png",
      "32": "store-assets/icon32.png",
      "48": "store-assets/icon48.png",
      "128": "store-assets/icon128.png"
    }
  },
  "icons": {
    "16": "store-assets/icon16.png",
    "32": "store-assets/icon32.png",
    "48": "store-assets/icon48.png",
    "128": "store-assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "optional_host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkday.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.workable.com/*",
    "https://*.bamboohr.com/*",
    "https://*.jobvite.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.recruitee.com/*",
    "https://*.breezy.hr/*",
    "https://*.rippling.com/*",
    "https://*.dover.com/*"
  ]
}
